@model CartViewModel
@{
    ViewData["Title"] = "Booking bekræftet";
}

<section class="container py-5 my-5">

    <div class="text-center mb-5">
        <span class="badge text-bg-warning rounded-pill mb-3">Booking bekræftet</span>
        <h2 class="display-6 fw-light">Tak for din booking!</h2>
        <p class="text-white-50">Dit udstyr står klar i butikken på startdatoen.</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">

            @foreach (var bundle in Model.Bundles)
            {
                <div class="card bg-white bg-opacity-10 border-0 rounded-4 mb-4">
                    <div class="card-body p-4">

                        <h3 class="h5 fw-bold mb-1">
                            @bundle.BundleName
                            <span class="badge text-bg-warning rounded-pill ms-2">-@bundle.DiscountPercent %</span>
                        </h3>
                        <p class="text-warning fw-bold mb-3">
                            Fra @bundle.StartTime.ToString("dd/MM/yyyy") til @bundle.EndTime.ToString("dd/MM/yyyy")
                        </p>

                        <ul class="list-unstyled mb-0">
                            @foreach (var item in bundle.Items)
                            {
                                <li class="py-2 border-bottom border-light border-opacity-10">
                                    @item.Brand @item.Model
                                    <span class="text-white-50">
                                        @if (!string.IsNullOrEmpty(item.SelectedGender))
                                        {
                                            <span>@item.SelectedGender -</span>
                                        }
                                        @item.SelectedSize
                                    </span>
                                </li>
                            }
                        </ul>

                    </div>
                </div>
            }

            @if (Model.Items.Count > 0)
            {
                <div class="card bg-white bg-opacity-10 border-0 rounded-4 mb-4">
                    <div class="card-body p-4">

                        <h3 class="h5 fw-bold mb-3">Enkelte produkter</h3>

                        <ul class="list-unstyled mb-0">
                            @foreach (var item in Model.Items)
                            {
                                <li class="py-2 border-bottom border-light border-opacity-10">
                                    @item.Brand @item.Model
                                    <span class="text-white-50">
                                        @item.SelectedSize
                                        (@item.StartTime.ToString("dd/MM/yyyy") til @item.EndTime.ToString("dd/MM/yyyy"))
                                    </span>
                                </li>
                            }
                        </ul>

                    </div>
                </div>
            }

            <div class="card bg-white bg-opacity-10 border-0 rounded-4">
                <div class="card-body p-4">

                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-white-50">Normalpris</span>
                        <span class="text-white-50">@Model.SubTotal.ToString("0") kr</span>
                    </div>

                    @if (Model.Discount > 0)
                    {
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-warning">Pakkerabat</span>
                            <span class="text-warning">-@Model.Discount.ToString("0") kr</span>
                        </div>
                    }

                    <div class="d-flex justify-content-between pt-3 border-top border-light border-opacity-10">
                        <span class="h5 fw-bold mb-0">I alt</span>
                        <span class="h5 fw-bold mb-0">@Model.Total.ToString("0") kr</span>
                    </div>

                    <div class="d-flex flex-wrap gap-3 justify-content-between pt-4">
                        <a asp-controller="Bundles" asp-action="Index" class="btn btn-warning rounded-4 px-4">Se flere pakker</a>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light rounded-4 px-4">Til forsiden</a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</section>
