@model CartViewModel
<div class="container py-5">

    <h1>Din kurv</h1>

    @* Beskeder fra CartController.Book *@
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="row">

        <div class="col-lg-8">

            @if (Model.Items.Count == 0 && Model.Bundles.Count == 0)
            {
                <div class="alert alert-info">
                    Din kurv er tom. <a asp-controller="Products" asp-action="Index">Gå til produkter</a>
                </div>
            }
            else
            {
                @foreach (var item in Model.Items)
                {
                    <div class="card mb-4 bg-dark border-secondary">

                        <div class="card-body">

                            <div class="row align-items-center">

                                @* <div class="col-md-2">
                                    @if (!string.IsNullOrEmpty(item.ImagePath))
                                    {
                                        <img src="@item.ImagePath" alt="@item.Brand @item.Model" class="img-fluid" style="max-height: 150px; object-fit: contain;">
                                    }
                                </div> *@

                                <div class="col-md-6">

                                    <h5>
                                        @item.Brand @item.Model
                                    </h5>

                                    <small class="text-muted d-block">
                                        @if (!string.IsNullOrEmpty(item.SelectedSize))
                                        {
                                            <span>Størrelse: @item.SelectedSize</span>
                                        }
                                        @if (!string.IsNullOrEmpty(item.SelectedGender))
                                        {
                                            <span> | Køn: @item.SelectedGender</span>
                                        }
                                    </small>

                                    <small class="text-muted d-block">
                                        Fra @item.StartTime.ToString("dd/MM/yyyy") til @item.EndTime.ToString("dd/MM/yyyy")
                                    </small>

                                </div>

                                <div class="col-md-2 text-end">

                                    <h6>
                                        @item.PricePerDay kr./dag
                                    </h6>

                                </div>

                                <div class="col-md-2 text-end">
                                    <form method="post" asp-action="RemoveFromCart" style="display: inline;">
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <input type="hidden" name="size" value="@item.SelectedSize" />
                                        <input type="hidden" name="gender" value="@item.SelectedGender" />
                                        <button type="submit" class="btn btn-sm btn-danger">
                                            <i class="bi bi-trash"></i> Slet
                                        </button>
                                    </form>
                                </div>

                            </div>

                        </div>

                    </div>
                }

                @* index bruges til at finde pakken, når den slettes *@
                @for (int i = 0; i < Model.Bundles.Count; i++)
                {
                    var bundle = Model.Bundles[i];

                    <div class="card mb-4 bg-dark border-secondary">

                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-center">

                                <div>
                                    <h5>
                                        @bundle.BundleName
                                        <span class="badge text-bg-warning rounded-pill ms-2">-@bundle.DiscountPercent %</span>
                                    </h5>

                                    <small class="text-muted d-block">
                                        Fra @bundle.StartTime.ToString("dd/MM/yyyy") til @bundle.EndTime.ToString("dd/MM/yyyy")
                                    </small>
                                </div>

                                <form method="post" asp-action="RemoveBundle" style="display: inline;">
                                    <input type="hidden" name="index" value="@i" />
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="bi bi-trash"></i> Slet pakke
                                    </button>
                                </form>

                            </div>

                            <hr>

                            @foreach (var item in bundle.Items)
                            {
                                <div class="d-flex justify-content-between">
                                    <span>
                                        @item.Brand @item.Model
                                        <small class="text-muted">
                                            @if (!string.IsNullOrEmpty(item.SelectedGender))
                                            {
                                                <span>@item.SelectedGender -</span>
                                            }
                                            @item.SelectedSize
                                        </small>
                                    </span>
                                    <span>@item.PricePerDay kr./dag</span>
                                </div>
                            }

                        </div>

                    </div>
                }
            }

        </div>

        <div class="col-lg-4">

            <div class="card bg-dark border-secondary">

                <div class="card-body">

                    <h3>Ordreoversigt</h3>

                    <hr>

                    <div class="d-flex justify-content-between">
                        <span>Udstyr (@(Model.Items.Count + Model.Bundles.Sum(b => b.Items.Count)))</span>
                        <span>@Model.SubTotal kr.</span>
                    </div>

                    @if (Model.Discount > 0)
                    {
                        <div class="d-flex justify-content-between">
                            <span>Pakkerabat</span>
                            <span>-@Model.Discount kr.</span>
                        </div>
                    }

                    <hr>

                    <div class="d-flex justify-content-between mb-3">
                        <strong>I alt</strong>
                        <strong>@Model.Total kr.</strong>
                    </div>

                    @if (Model.Items.Count > 0 || Model.Bundles.Count > 0)
                    {
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <form method="post" asp-action="Book">
                                <button type="submit" class="btn btn-warning w-100 mb-2">
                                    Book
                                </button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-warning w-100 mb-2"
                               asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="/Cart">
                                Log ind for at booke
                            </a>
                        }
                    }

                    <form method="post" asp-action="ClearCart">
                        <button type="submit" class="btn btn-outline-danger w-100">
                            Tøm kurven
                        </button>
                    </form>

                </div>

            </div>

        </div>

    </div>

</div>
