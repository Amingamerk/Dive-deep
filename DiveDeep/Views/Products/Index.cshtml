@model List<CategoryCardViewModel>

<div class="row row-cols-auto row-cols-md-3 g-4">
    @foreach (CategoryCardViewModel category in Model)
    {

        <div class="col">
            <div class="card h-100 bg-white bg-opacity-10 border-0 rounded-4" style="width: 22rem;">
                <div class="card-body p-4 d-flex flex-column">
                    <a asp-controller="Products"
                       asp-action="Category"
                       asp-route-category="@category.RouteId"
                       class="stretched-link text-decoration-none text-white">
                        @category.Title
                    </a>
                    <img src="@category.ImagePath"
                         class="object-fit-contain p-1"
                         alt="@category.AltText">
                </div>
            </div>
        </div>
    }
</div>