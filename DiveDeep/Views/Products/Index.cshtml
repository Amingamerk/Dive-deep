@model List<CategoryCardViewModel>

<div class="row row-cols-auto row-cols-md-3">
    @foreach (CategoryCardViewModel category in Model)
    {
        <div class="col">
            <div class="card h-100 g-4 p-5 border-0 shadow-sm rounded-4 position-relative category-card bg-transparent">
                <div class="ratio ratio-1x1">
                    <img src="@category.ImagePath" class="object-fit-contain p-1" alt="@category.AltText">
                </div>
                <div class="card-body text-center">
                    <h3 class="card-title h6 mb-0">
                        <a asp-controller="Products" asp-action="Category" asp-route-category="@category.RouteId"
                           class="stretched-link text-decoration-none">@category.Title</a>
                    </h3>
                </div>
            </div>
        </div>
    }
</div>