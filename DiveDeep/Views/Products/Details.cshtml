@model DiveDeep.Models.Product


<div class="container mt-4" style="max-width: 600px;">


    <form method="post" class="card p-4 shadow-sm">
        <div class="mb-3">
            <h3 class="form-label">Mærke: @Model.Brand</h3>
        </div>

        <div class="mb-3">
            <h3 class="form-label">Model: @Model.Model</h3>
        </div>

        @if (Model.SizeOptions?.Any() == true)
        {
            <div class="mb-3">
                <label class="form-label">@Model.SizeLabel</label>
                <select class="form-select" name="Size">
                    @foreach (var size in ViewBag.SizeOptions)
                    {
                        <option>@size</option>
                    }
                </select>
            </div>
        }


        
        <div class="d-flex justify-content-between">
            <a asp-controller="Products" asp-action="Index" class="btn btn-danger">Cancel</a>
            <button type="submit" class="btn btn-primary">Book</button>
        </div>
    </form>
</div>
