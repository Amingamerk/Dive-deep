@model DiveDeep.ViewModels.ProductViewModel

<div class="container mt-4" style="max-width: 600px;">
    @* Fejlbesked fra BookingsController, fx hvis datoerne ikke kunne læses *@
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (TempData["Success"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                document.getElementById('toastMessage').textContent = '@TempData["Success"]';
                var toastElement = document.getElementById('addToCartToast');
                toastElement.style.display = 'block';

                setTimeout(function () {
                    toastElement.style.display = 'none';
                }, 3000);
            });
        </script>
    }

    <!-- Toast for success message -->
    <div id="addToCartToast" class="position-fixed bottom-0 end-0 p-3" style="z-index: 11; display: none;">
        <div class="toast show bg-success text-white" role="alert">
            <div class="toast-header bg-success text-white border-0">
                <strong class="me-auto">Tilføjet!</strong>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body" id="toastMessage">
                Produktet er tilføjet til kurven
            </div>
        </div>
    </div>

    <form asp-controller="Cart"
          asp-action="AddToCart"
          method="post"
          class="card p-4 shadow-sm">

        <div class="mb-3">
            <h3 class="form-label">Mærke: @Model.Brand</h3>
        </div>

        <div class="mb-3">
            <h3 class="form-label">Model: @Model.Model</h3>
        </div>

        @if (Model.Variants.Count > 1)
        {
            <div class="mb-3">
                <label class="form-label">@Model.VariantHeading</label>
                <select class="form-select" name="ProductId">
                    @foreach (var group in Model.Variants.GroupBy(v => v.Group))
                    {
                        if (group.Key != null)
                        {
                            <optgroup label="@group.Key">
                                @foreach (var variant in group)
                                {
                                    <option value="@variant.ProductId" selected="@(variant.ProductId == Model.SelectedProductId)">@variant.Label</option>
                                }
                            </optgroup>
                        }
                        else
                        {
                            foreach (var variant in group)
                            {
                                <option value="@variant.ProductId" selected="@(variant.ProductId == Model.SelectedProductId)">@variant.Label</option>
                            }
                        }
                    }
                </select>
            </div>
        }
        else
        {
            <input type="hidden" name="ProductId" value="@Model.SelectedProductId" />
        }

        <input type="text"
               class="form-control"
               placeholder="Vælg datoer"
               name="DateRange"
               id="dateRange"
               required />

        <div class="py-3 d-flex justify-content-between">

            <button type="submit" class="btn btn-primary">
                Tilføj til kurv
            </button>

            <a asp-controller="Products"
               asp-action="Index"
               class="btn btn-danger">
                Afbryd
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        flatpickr('#dateRange', {
            mode: 'range',
            dateFormat: 'd/m/Y',
            minDate: 'today',
            locale: 'da',
            disable: @Html.Raw(Json.Serialize(Model.BookedDates))
        });

        var variantSelect = document.querySelector('select[name="ProductId"]');

        if (variantSelect !== null) {
            variantSelect.addEventListener('change', function () {
                window.location = '/Products/Details/' + this.value;
            });
        }
    </script>
}