@model List<DiveDeep.ViewModels.BundleCardViewModel>
@* ---------- Pakkeløsninger ---------- *@
<section class="container py-5 my-5">
    <h2 class="text-center display-6 fw-light mb-5">Pakkeløsninger</h2>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (BundleCardViewModel viewModel in Model)
        {
            <div class="col">
                <div class="card h-100 bg-white bg-opacity-10 border-0 rounded-4">
                    <div class="card-body p-4 d-flex flex-column">
                        <span class="badge bg-warning rounded-pill align-self-start mb-3 text-black fw-bold">-@viewModel.DiscountPercent%</span>
                        <h3 class="card-title h5 fw-bold">@viewModel.Name</h3>
                        <p class="text-warning fw-bold">fra @viewModel.FromPricePerDay.ToString("0") kr/dag</p>
                        <p class="card-text text-white-50">
                            @viewModel.Description
                            Vælg størrelse og periode, så står det klar.
                        </p>
                        <a class="btn btn-warning rounded-4 align-self-start mt-auto px-4" asp-controller="Bundles" asp-action="Details" asp-route-id="@viewModel.BundleId">Vælg pakke</a>
                    </div>
                </div>
            </div>
        }

        <div class="col">
            <div class="card h-100 bg-white bg-opacity-10 border-0 rounded-4">
                <div class="card-body p-4 d-flex flex-column">
                    <h3 class="card-title h5 fw-bold mt-5 pt-2">Lej enkelte dele efter behov</h3>
                    <p class="text-warning fw-bold">fra 50 kr/dag</p>
                    <p class="card-text text-white-50">
                        Mangler du kun en tank eller et par finner? 
                        <br /> Lej de enkelte dele i præcis den periode, du skal bruge dem.
                    </p>
                    <a class="btn btn-outline-light rounded-4 align-self-start mt-auto px-4" asp-controller="Products" asp-action="Index">Se kategorier</a>
                </div>
            </div>
        </div>
    </div>
</section>