@model List<Booking>
@{
    ViewData["Title"] = "Mine bookinger";
}

<div class="container py-5">

    <h1>Mine bookinger</h1>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            Du har ingen bookinger endnu. <a asp-controller="Products" asp-action="Index">Gå til produkter</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Produkt</th>
                        <th>Variant</th>
                        <th>Fra</th>
                        <th>Til</th>
                        <th>Pakke</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var booking in Model)
                    {
                        <tr>
                            <td>@booking.Product.Brand @booking.Product.Model</td>
                            <td>
                                @if (booking.Product.VariantGroup != null)
                                {
                                    @($"{booking.Product.VariantGroup} - {booking.Product.VariantLabel}")
                                }
                                else
                                {
                                    @booking.Product.VariantLabel
                                }
                            </td>
                            <td>@booking.StartTime.ToString("dd/MM/yyyy")</td>
                            <td>@booking.EndTime.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (booking.BundleBooking != null)
                                {
                                    <span class="badge text-bg-warning">@booking.BundleBooking.BundleName</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</div>
