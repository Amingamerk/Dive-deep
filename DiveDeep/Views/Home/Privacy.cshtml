@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1>Privatlivspolitik</h1>
        <p class="lead">
            Her kan du læse, hvordan Dive Deep behandler dine personoplysninger.
        </p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <section class="mb-4">
                <h2>Hvilke oplysninger indsamler vi?</h2>
                <p>
                    Når du foretager en booking eller kontakter os, kan vi indsamle
                    oplysninger som navn, e-mailadresse, telefonnummer og oplysninger
                    om din reservation.
                </p>
            </section>

            <section class="mb-4">
                <h2>Hvordan bruger vi dine oplysninger?</h2>
                <p>
                    Vi bruger dine oplysninger til at håndtere bookinger, kommunikere
                    med dig om din lejeaftale og levere den bedst mulige service.
                </p>
            </section>

            <section class="mb-4">
                <h2>Opbevaring af oplysninger</h2>
                <p>
                    Vi opbevarer kun dine personoplysninger så længe, det er nødvendigt
                    for at administrere din booking eller opfylde gældende lovgivning.
                </p>
            </section>

            <section class="mb-4">
                <h2>Deling af oplysninger</h2>
                <p>
                    Vi sælger ikke dine personoplysninger. Oplysninger deles kun med
                    relevante samarbejdspartnere, hvis det er nødvendigt for at
                    gennemføre din booking eller påkrævet ved lov.
                </p>
            </section>

            <section class="mb-4">
                <h2>Dine rettigheder</h2>
                <p>
                    Du har ret til at få indsigt i de oplysninger, vi har om dig.
                    Du kan også anmode om at få oplysninger rettet eller slettet,
                    medmindre vi er forpligtet til at gemme dem.
                </p>
            </section>

            <section class="mb-4">
                <h2>Kontakt</h2>
                <p>
                    Hvis du har spørgsmål om vores privatlivspolitik eller ønsker at
                    gøre brug af dine rettigheder, er du velkommen til at kontakte os.
                </p>
                <p>
                    E-mail:
                    <a href="mailto:kontakt@divedeep.dk">kontakt@divedeep.dk</a>
                </p>
            </section>

            <p class="text-muted">
                Sidst opdateret: @DateTime.Now.ToString("dd-MM-yyyy")
            </p>
        </div>
    </div>
</div>
