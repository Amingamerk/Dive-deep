ice og passion for havet hjælper vi dykkere med at finde den rette ballast for fantastiske oplevelser under vandet.                        </p>            <p class="lead text-white">                                     Uanset om du tager dit første dyk eller udforsker nye dybder, er vi din sikre makker hele vejen fra briefing til opstigning.            </p>        </div>                               <!-- Billede -->    <div class="col-lg-6 text-center">        <img src="~/images/AboutUs-lille.png" alt="Cartoon diver">    </div>            </div></div></section><section class="values-section py-5">            <div class="row">        <div class="text-center text-white">    <h3 class="display-1 fw-bold py-5">Tre kerneværdier</h3>        </div>    </div>    <style>        .value-circle {width: 200px;height: 200px; border-radius: 50%; object-fit: cover;}                </style>                <div class="container">                        <div class="row text-center">                    <!-- Værdi 1 -->                                    <div class="col-md-4">                                           <img src="~/images/values/sikkerhed.png"                                                 class="value-circle mb-3"                                                alt="Sikkerhed">                        <h3 class="text-white">Sikkerhed</h3>                                    </div>                    <!-- Værdi 2 -->                                    <div class="col-md-4">                                                  <img src="~/images/values/ekspert.png"                         class="value-circle mb-3"                         alt="Tandhjul">                    <h3 class="text-white">Ekspertise</h3>                                    </div>                    <!-- Værdi 3 -->                                    <div class="col-md-4 mb-3">                        <img src="~/images/values/Passion.png"                      