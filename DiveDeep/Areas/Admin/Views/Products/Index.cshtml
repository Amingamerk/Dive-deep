@model List<Product>
@{
    ViewData["Title"] = "Produkter";
    ProductCategory? selectedCategory = ViewBag.Category;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Produkter <span class="text-body-secondary fs-6">(@Model.Count stk.)</span></h1>

    <div class="dropdown">
        <button class="btn btn-warning dropdown-toggle" type="button" data-bs-toggle="dropdown">
            Tilføj produkt
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
            @foreach (var category in CategoryInfo.Categories)
            {
                <li><a class="dropdown-item" asp-action="Add" asp-route-category="@category.Key">@category.Value.Title</a></li>
            }
        </ul>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="row">
    <div class="col-md-3 mb-4">
        <div class="list-group">
            <a asp-action="Index" class="list-group-item list-group-item-action @(selectedCategory == null ? "active" : "")">Alle</a>
            @foreach (var category in CategoryInfo.Categories)
            {
                <a asp-action="Index" asp-route-category="@category.Key"
                   class="list-group-item list-group-item-action @(selectedCategory == category.Key ? "active" : "")">@category.Value.Title</a>
            }
        </div>
    </div>

    <div class="col-md-9">
        @if (Model.Count == 0)
        {
            <p class="text-body-secondary">Der er ingen produkter i denne kategori.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Kategori</th>
                            <th>Mærke</th>
                            <th>Model</th>
                            <th>Variant</th>
                            <th class="text-end">Pris/dag</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (Product product in Model)
                        {
                            <tr>
                                <td>@product.ProductId</td>
                                <td>@CategoryInfo.Categories[product.Category].Title</td>
                                <td>@product.Brand</td>
                                <td>@product.Model</td>
                                <td>
                                    @* Dragter har også køn og tykkelse, fx "Herre – 5 mm" *@
                                    @if (product.VariantGroup != null)
                                    {
                                        @($"{product.VariantGroup} - {product.VariantLabel}")
                                    }
                                    else
                                    {
                                        @product.VariantLabel
                                    }
                                </td>
                                <td class="text-end">@product.PricePerDay.ToString("0") kr</td>
                                <td class="text-end text-nowrap">
                                    <a asp-action="Edit" asp-route-id="@product.ProductId" class="btn btn-sm btn-outline-warning">Rediger</a>
                                    <form method="post" asp-action="Delete" asp-route-id="@product.ProductId" class="d-inline"
                                          onsubmit="return confirm('Slet produktet?')">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Slet</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
