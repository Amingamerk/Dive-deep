<div class="flex-shrink-0 p-3 vh-100 sticky-top" style="width: 280px">
    <a asp-area="Admin" asp-controller="Home" asp-action="Index"
        class="d-flex align-items-center pb-3 mb-3 link-body-emphasis text-decoration-none border-bottom">
        <span class="fs-5 fw-semibold">DIVE DEEP ADMIN</span>
    </a>
    <ul class="list-unstyled ps-0">
        <li class="mb-1">
            <button class="btn btn-toggle d-inline-flex align-items-center rounded border-0 collapsed"
                    data-bs-toggle="collapse"
                    data-bs-target="#home-collapse"
                    aria-expanded="true">
                Hjem
            </button>
            <div class="collapse show" id="home-collapse">
                <ul class="btn-toggle-nav list-unstyled fw-normal pb-1 small">
                    <li>
                        <a asp-area="Admin" asp-controller="Home" asp-action="Index"
                            class="link-body-emphasis d-inline-flex text-decoration-none rounded">Overblik</a>
                    </li>
                </ul>
            </div>
        </li>
        <li class="mb-1">
            <button class="btn btn-toggle d-inline-flex align-items-center rounded border-0 collapsed"
                    data-bs-toggle="collapse"
                    data-bs-target="#bookings-collapse"
                    aria-expanded="false">
                Bookinger
            </button>
            <div class="collapse" id="bookings-collapse">
                <ul class="btn-toggle-nav list-unstyled fw-normal pb-1 small">
                    <li>
                        <a asp-area="Admin" asp-controller="Bookings" asp-action="Index"
                           class="link-body-emphasis d-inline-flex text-decoration-none rounded">Oversigt</a>
                    </li>
                </ul>
            </div>
        </li>
        <li class="mb-1">
            <button class="btn btn-toggle d-inline-flex align-items-center rounded border-0 collapsed"
                    data-bs-toggle="collapse"
                    data-bs-target="#products-collapse"
                    aria-expanded="false">
                Produkter
            </button>
            <div class="collapse" id="products-collapse">
                <ul class="btn-toggle-nav list-unstyled fw-normal pb-1 small">
                    <li>
                        <a asp-area="Admin" asp-controller="Products" asp-action="Index"
                           class="link-body-emphasis d-inline-flex text-decoration-none rounded">Oversigt</a>
                    </li>
                </ul>
            </div>
        </li>
        <li class="border-top my-3"></li>
        <li class="mb-1">
            <button class="btn btn-toggle d-inline-flex align-items-center rounded border-0 collapsed"
                    data-bs-toggle="collapse"
                    data-bs-target="#account-collapse"
                    aria-expanded="false">
                Konto
            </button>
            <div class="collapse" id="account-collapse">
                <ul class="btn-toggle-nav list-unstyled fw-normal pb-1 small">
                    <li>
                        <a href="#"
                            class="link-body-emphasis d-inline-flex text-decoration-none rounded">Ny...</a>
                    </li>
                    <li>
                        <a href="#"
                            class="link-body-emphasis d-inline-flex text-decoration-none rounded">Profil</a>
                    </li>
                    <li>
                        <a href="#"
                            class="link-body-emphasis d-inline-flex text-decoration-none rounded">Indstillinger</a>
                    </li>
                    <li>
                        <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                            <button type="submit" class="btn btn-link p-0 link-body-emphasis d-inline-flex text-decoration-none rounded">Log ud</button>
                        </form>
                    </li>
                </ul>
            </div>
        </li>
        <li class="border-top my-3"></li>
        <li class="mb-1">
            <a asp-area="" asp-controller="Home" asp-action="Index"
               class="btn btn-warning fw-semibold d-inline-flex align-items-center">
               Forlad adminpanelet
           </a>
        </li>
    </ul>
</div>