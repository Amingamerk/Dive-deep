@using static Dive_deep.Models.Enums;
@model List<ProductCategory>
@{
    <div class="col-6 col-md-4 col-lg-3">
        @foreach (ProductCategory productCategory in Model)
        {
            <div class="card h-50 border-0 shadow-sm rounded-4 position-relative category-card">
                <div class="ratio ratio-1x1">
                    <img src="~/images/products/categories/tank.png" class="object-fit-contain p-4" alt="Dykkertank">
                </div>
                <div class="card-body text-center">
                    <h3 class="card-title h6 mb-0">
                        <a asp-controller="Category" asp-action="Index" asp-route-id="tanke"
                            class="stretched-link text-decoration-none">Dykkertanke</a>
                    </h3>
                </div>
            </div>
        }
    </div>
}