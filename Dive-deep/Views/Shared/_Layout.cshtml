@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers


<!DOCTYPE html>
<html lang="da" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dive Deep</title>

    @* Skrifttype - kan fjernes, så bruges systemets standardskrift *@
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;500;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg position-absolute top-0 w-100 z-3 py-3">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">DIVE DEEP</a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#menu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse justify-content-end" id="menu">
                <ul class="navbar-nav align-items-lg-center gap-lg-3">
                    <li class="nav-item"><a class="nav-link" asp-controller="Products" asp-action="Index">Udstyr</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Bundels" asp-action="Index">Pakker</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="FAQ">FAQ</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="AboutUs">Om os</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contact">Kontakt</a></li>
                    <li class="nav-item ms-lg-3 mt-3 mt-lg-0">
                        <a class="btn btn-warning rounded-4 px-4" asp-controller="Bundels" asp-action="Index">Lej udstyr</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="border-top border-light border-opacity-10 pt-5 pb-4 mt-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <h2 class="h6 fw-bold mb-3">DIVE DEEP</h2>
                    <p class="text-white-50 mb-1">Dykkervej 10<br />5000 Odense C</p>
                    <p class="text-white-50 mb-0">CVR: 81828384</p>
                </div>
                <div class="col-md-4">
                    <h2 class="h6 fw-bold mb-3">KONTAKT</h2>
                    <p class="mb-1"><a class="text-white-50" href="tel:+4560708090">+45 60 70 80 90</a></p>
                    <p class="mb-0"><a class="text-white-50" href="mailto:info@divedeep.dk">info@divedeep.dk</a></p>
                </div>
                <div class="col-md-4">
                    <h2 class="h6 fw-bold mb-3">ÅBNINGSTIDER</h2>
                    <ul class="list-unstyled text-white-50 mb-0">
                        <li>Mandag-fredag: 10:00-17:30</li>
                        <li>Lørdag: 10:00-14:00</li>
                        <li>Søndag: lukket</li>
                    </ul>
                </div>
            </div>

            <div class="border-top border-light border-opacity-10 mt-5 pt-3 d-flex flex-column flex-md-row justify-content-between text-white-50 small">
                <p class="mb-0">© @DateTime.Now.Year Dive Deep.</p>
                <p class="mb-0"><a class="text-white-50" asp-controller="Home" asp-action="Privacy">Privatlivspolitik</a></p>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
